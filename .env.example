# 503MD environment — copy to .env.local (never commit real values).

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Where provider-registration leads are forwarded (optional).
# A Zapier/n8n/Make webhook, a Slack incoming webhook, etc. If unset, leads are
# written to the server log so nothing is silently lost. No PHI is collected.
CONTACT_WEBHOOK_URL=
